PORT=4318
# 留空时显示本机 IPv4，手机与电脑需在同一可互通的 Wi-Fi。
PUBLIC_BASE_URL=
DEFAULT_PROVIDER=doubao
# 每次回答携带的此前问答轮数（0-20）；越大越连贯，请求费用与时延也越高。也可在软件设置中修改。
CONTEXT_TURNS=6

# 豆包：使用你已开通的模型 ID 或推理接入点 ID。
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
DOUBAO_VISION_MODEL=

# DeepSeek 模型名称也可按账户支持情况修改。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 截图模型可指定 doubao 或支持图像输入的 deepseek 模型。
VISION_PROVIDER=doubao
VISION_MODEL=
MODEL_TIMEOUT_MS=120000
